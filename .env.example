# PushPlus 登录后获得的 Token。不要把真实值提交到 Git。
PUSHPLUS_TOKEN=

# wechat：微信公众号消息；qq：QQ 机器人渠道。
PUSHPLUS_CHANNEL=wechat

# 可选：PushPlus 群组编码，或 QQ 好友/群号。
PUSHPLUS_TOPIC=
PUSHPLUS_TO=

# 可选：QQ 群消息必须填写 PushPlus 渠道配置编码；微信个人消息无需填写。
PUSHPLUS_OPTION=

# 北京时间：0=周一，2=周三，5=周六；开奖后更新并生成下一期候选。
DLT_TIMEZONE=Asia/Shanghai
DLT_SCHEDULE_TIME=22:35
DLT_SCHEDULE_WEEKDAYS=0,2,5
DLT_SCHEDULE_RETRY_MINUTES=10

DLT_HOST=0.0.0.0
DLT_PORT=8000
LOG_LEVEL=INFO

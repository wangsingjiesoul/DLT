# 复制本文件为 .env 后再填写。修改 .env 后需要重启程序才会生效。
# 默认使用 Qmsg酱发送到 QQ。Key、Token、群号不要提交到 Git 或发到聊天中。
NOTIFY_PROVIDER=qmsg
QMSG_KEY=

# 可选：发送到 QQ 群时填写群号；留空则发送到绑定的 QQ 单聊。
QMSG_GROUP=

# 可选兼容：仅当 NOTIFY_PROVIDER=pushplus 时使用。会员渠道是否可用以你的账号后台为准。
PUSHPLUS_TOKEN=
# 多渠道用逗号分隔；例如 wechat,qq。留空时兼容读取 PUSHPLUS_CHANNEL。
PUSHPLUS_CHANNELS=
PUSHPLUS_CHANNEL=wechat
# topic/to/option 都是可选扩展字段；普通微信推送通常留空。
PUSHPLUS_TOPIC=
PUSHPLUS_TO=
PUSHPLUS_OPTION=

# 外部 AI 模型（兼容 OpenAI chat/completions 接口）。
# 开启后，统计层先生成合法候选池，AI 只能从候选 ID 中选择，不能任意创造号码。
AI_ENABLED=false
# true：AI 失败就停止预测和通知；false：AI 失败时明确回退到统计排序。
AI_REQUIRED=false
# 第三方 NewAPI 通常填写 https://你的域名/v1，不要填写 /chat/completions。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# 填写你的服务商实际提供的模型 ID；不要凭空猜模型名。
AI_MODEL=
AI_TIMEOUT=30

# 北京时间：0=周一，2=周三，5=周六；开奖后更新并生成下一期候选。
DLT_TIMEZONE=Asia/Shanghai
DLT_SCHEDULE_TIME=22:35
DLT_SCHEDULE_WEEKDAYS=0,2,5
DLT_SCHEDULE_RETRY_MINUTES=10

# 服务器部署用 0.0.0.0；只允许本机访问时改为 127.0.0.1。
DLT_HOST=0.0.0.0
DLT_PORT=8009
# INFO 适合日常运行；DEBUG 仅用于临时排错，避免长期产生过多日志。
LOG_LEVEL=INFO
